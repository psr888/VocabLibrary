[{"Word":"despondent","Definitions":[{"Partofspeech":"adj","Meaning":"feeling depressed, discouraged, hopeless","Sentence":"Having failed the first math test, the despondent child saw no use in studying for the next and failed that one too."}]},{"Word":"despot","Definitions":[{"Partofspeech":"n","Meaning":"one who has total power and rules brutally ","Sentence":"The despot issued a death sentence for anyone who disobeyed his laws."}]},{"Word":"destitute","Definitions":[{"Partofspeech":"adj","Meaning":"impoverished, utterly lacking","Sentence":"The hurricane destroyed many homes and left many families destitute."}]},{"Word":"deter","Definitions":[{"Partofspeech":"v","Meaning":"to discourage, prevent from doing","Sentence":"Bob’s description of scary snakes couldn’t deter Marcia from traveling in the rainforests."}]},{"Word":"devious","Definitions":[{"Partofspeech":"adj","Meaning":"not straightforward, deceitful","Sentence":"Not wanting to be punished, the devious girl blamed the broken vase on the cat."}]},{"Word":"dialect","Definitions":[{"Partofspeech":"n","Meaning":" a variation of a language","Sentence":"In the country’s remote, mountainous regions, the inhabitants spoke a dialect that the country’s other inhabitants had difficulty understanding. "}]},{"Word":"diaphanous","Definitions":[{"Partofspeech":"adj","Meaning":"light, airy, transparent","Sentence":"Sunlight poured in through the diaphanous curtains, brightening the room."}]},{"Word":"didactic","Definitions":[{"Partofspeech":"adj","Meaning":"intended to instruct","Sentence":"She wrote up a didactic document showing new employees how to handle the company’s customers."},{"Partofspeech":"adj","Meaning":"overly moralistic","Sentence":"His didacticstyle of teaching made it seem like he wanted to persuade his students not to understand history fully, but to understand it from only one point of view."}]},{"Word":"diffident","Definitions":[{"Partofspeech":"adj","Meaning":"shy, quiet, modest","Sentence":"While eating dinner with the adults, the diffident youth did not speak for fear of seeming presumptuous."}]},{"Word":"diffuse","Definitions":[{"Partofspeech":"v","Meaning":"to scatter, thin out, break up ","Sentence":"He diffused the tension in the room by making in a joke."},{"Partofspeech":"adj","Meaning":"not concentrated, scattered, disorganized","Sentence":"In her writings, she tried unsuccessfully to make others understand her diffuse thoughts."}]},{"Word":"dilatory","Definitions":[{"Partofspeech":"adj","Meaning":"tending to delay, causing delay","Sentence":"The general’s dilatory strategy enabled the enemy to regroup."}]},{"Word":"diligent","Definitions":[{"Partofspeech":"adj","Meaning":"showing care in doing one’s work","Sentence":"The diligent researcher made sure to check her measurements multiple times."}]},{"Word":"diminutive","Definitions":[{"Partofspeech":"adj","Meaning":"small or miniature ","Sentence":"The bullies, tall and strong, picked on the diminutive child."}]},{"Word":"dirge","Definitions":[{"Partofspeech":"noun","Meaning":" a mournful song, especially for a funeral","Sentence":"The bagpipers played a dirge as the casket was carried to the cemetery."}]}]