[{"Word":"demagogue","Definitions":[{"Partofspeech":"n","Meaning":"a leader who appeals to a people’s prejudices","Sentence":"The demagogue strengthened his hold over his people by blaming immigrants for the lack of jobs"}]},{"Word":"demarcation","Definitions":[{"Partofspeech":"n","Meaning":"the marking of boundaries or categories","Sentence":"Different cultures have different demarcations of good and evil."}]},{"Word":"demean","Definitions":[{"Partofspeech":"v","Meaning":" to lower the status or stature of something","Sentence":"She refused to demean her secretary by making him order her lunch."}]},{"Word":"demure","Definitions":[{"Partofspeech":"adj","Meaning":"quiet, modest, reserved","Sentence":"Though everyone else at the party was dancing and going crazy, she remained demure."}]},{"Word":"denigrate","Definitions":[{"Partofspeech":"v","Meaning":"to belittle, diminish the opinion of ","Sentence":"The company decided that its advertisements would no longer denigrate the company’s competitors."}]},{"Word":"denounce","Definitions":[{"Partofspeech":"v","Meaning":" to criticize publicly","Sentence":"The senator denounced her opponent as a greedy politician."}]},{"Word":"deplore","Definitions":[{"Partofspeech":"v","Meaning":" to feel or express sorrow, disapproval","Sentence":"We all deplored the miserable working conditions in the factory."}]},{"Word":"depravity","Definitions":[{"Partofspeech":"n","Meaning":"wickedness","Sentence":"Rumors of the ogre’s depravity made the children afraid to enter the forest."}]},{"Word":"deprecate","Definitions":[{"Partofspeech":"v","Meaning":"to belittle, depreciate ","Sentence":"Always over-modest, he deprecated his contribution to the local charity."}]},{"Word":"derelict","Definitions":[{"Partofspeech":"adj","Meaning":"abandoned, run-down","Sentence":"Even though it was dangerous, the children enjoyed going to the deserted lot and playing in the derelict house."}]},{"Word":"deride","Definitions":[{"Partofspeech":"v","Meaning":" to laugh at mockingly, scorn","Sentence":"The bullies derided the foreign student’s accent."}]},{"Word":"derivative","Definitions":[{"Partofspeech":"adj","Meaning":"taken directly from a source, unoriginal","Sentence":"She was bored by his music because she felt that it was derivative and that she had heard it before."}]},{"Word":"desecrate","Definitions":[{"Partofspeech":"v","Meaning":"to violate the sacredness of a thing or place","Sentence":"They feared that the construction of a golf course would desecrate the preserved wilderness."}]},{"Word":"desiccated","Definitions":[{"Partofspeech":"adj","Meaning":"dried up, dehydrated","Sentence":"The skin of the desiccated mummy looked like old paper."}]},{"Word":"desolate","Definitions":[{"Partofspeech":"adj","Meaning":"deserted, dreary, lifeless","Sentence":"She found the desolate landscape quite a contrast to the hustle and bustle of the overcrowded city."}]}]